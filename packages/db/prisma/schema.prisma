generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              String      @id @default(cuid())
  email           String      @unique
  name            String?
  phone           String?     @unique
  phoneVerifiedAt DateTime?
  // Верификация личного номера кодом, отправленным с номера WhatsApp-бота.
  // Код хранится временно (TTL ~10 мин) с ограничением попыток ввода.
  phoneVerifyCode      String?
  phoneVerifyExpiresAt DateTime?
  phoneVerifyAttempts  Int       @default(0)
  // Кандидат-номер: вводится до верификации, переносится в phone только
  // после успешного подтверждения (чтобы unique-номер не «занимался» зря).
  phonePending         String?
  googleId        String?     @unique
  avatarUrl       String?
  telegramChatId  String?
  onboardingState Json?
  // Биллинг. quotaTotal — всего куплено (включая free trial 35).
  // quotaUsed — сколько уникальных клиентов-в-месяц учтено за всё время
  // (живёт без сброса, потому что каждая monthly-active единица = 1 списание).
  // При исчерпании quotaUsed >= quotaTotal бот перестаёт отвечать (block_all).
  quotaTotal      Int         @default(35)
  quotaUsed       Int         @default(0)
  // Подписка: текущий тариф и дата окончания месяца. null = только free trial.
  // Авто-продления нет (платёжный шлюз пока заглушка) — продление вручную.
  planId             String?
  subscriptionEndsAt DateTime?
  // Дневной лимит токенов LLM (sum input+output) — защита от взрыва счёта
  // на OpenAI. По умолчанию 50_000 для free trial (~10-15 диалогов в день).
  // У платных пользователей увеличивается в момент покупки пакета.
  dailyTokenLimit Int         @default(50000)
  // GDPR/152-ФЗ: «право на забвение». При удалении аккаунта PII-поля
  // (email/name/phone/google/avatar/telegram) обнуляются или заменяются
  // на placeholder, а сюда ставится timestamp. Все queries фильтруют
  // deletedAt IS NULL — такой User не может залогиниться и не виден в API.
  // Сам ряд оставляем, чтобы FK на Purchase/LlmCallLog/UsageEvent/AuditLog
  // оставались валидными (история транзакций сохраняется обезличенно).
  deletedAt       DateTime?
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt
  sessions        Session[]
  agents          Agent[]
  usageEvents     UsageEvent[]
  purchases       Purchase[]
  llmCallLogs     LlmCallLog[]
  waPhoneClaims   WaPhoneClaim[]
}

// Лог каждого вызова OpenAI: модель, токены, стоимость, latency, статус.
// Источник истины для:
//   - per-user daily budget (sumTokens за UTC-день);
//   - админ-дашборда «кто ест деньги»;
//   - алертов при аномалиях.
// Хранится бессрочно (можно архивировать через 90 дней при росте объёма).
model LlmCallLog {
  id              String   @id @default(cuid())
  userId          String?
  agentId         String?
  route           String   // "builder" | "runtime" | "correction" | "wa-inbound"
  model           String
  inputTokens     Int      @default(0)
  outputTokens   Int      @default(0)
  totalTokens     Int      @default(0)
  // USD * 1_000_000 (микро-доллары) — чтобы хранить целым числом без float-погрешностей.
  // Пример: $0.0025 = 2500.
  costMicroUsd    Int      @default(0)
  latencyMs       Int      @default(0)
  status          String   // "ok" | "error" | "timeout" | "budget_blocked"
  errorCode       String?
  createdAt       DateTime @default(now())
  user            User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt])
  @@index([agentId, createdAt])
  @@index([createdAt])
}

// Один UsageEvent = одна (userId, chatId, periodKey) тройка.
// periodKey формата "YYYY-MM" (UTC) — раз в месяц уникальность chatId
// сбрасывается, и тот же клиент снова стоит 1 диалог.
//
// userId nullable + SetNull: при удалении аккаунта userId обнуляется, но
// записи остаются для агрегированной аналитики. Postgres UNIQUE с NULL
// разрешает множественные NULL, так что коллизий не будет.
model UsageEvent {
  id         String   @id @default(cuid())
  userId     String?
  chatId     String
  periodKey  String
  agentId    String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([userId, chatId, periodKey])
  @@index([userId, periodKey])
}

// История покупок пакетов диалогов. Пока stub-оплата — статус сразу "paid".
//
// userId nullable + SetNull: бухгалтерия требует сохранять записи о
// транзакциях даже после удаления аккаунта пользователя (152-ФЗ + НК РФ
// о хранении первичных документов). При удалении userId обнуляется,
// сама запись с amount/createdAt/packageId остаётся.
model Purchase {
  id           String   @id @default(cuid())
  userId       String?
  packageId    String   // "free" | "basic" | "pro" | "max" | "custom"
  conversations Int
  pricePerOne  Int      // \u20b8 за 1 диалог (на момент покупки, для прозрачности)
  amount       Int      // итоговая сумма в тенге
  currency     String   @default("KZT")
  status       String   @default("paid") // "pending" | "paid" | "refunded"
  metadata     Json?
  createdAt    DateTime @default(now())
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

model Session {
  id             String   @id @default(cuid())
  cookieId       String   @unique
  userId         String?
  agentId        String?
  readyToFinalize Boolean @default(false)
  isGenerating   Boolean  @default(false)
  promptDraft    String   @default("")
  testBotStage   String   @default("")
  // Буфер «потребности клиента» для теста (v2.3). Пишется при первом извлечении
  // и при явной смене запроса (needChanged). Чистится на /test-chat/reset.
  detectedNeed   String?
  createAgentHistory Json
  promptBuilderHistory Json
  testBotHistory  Json
  expiresAt      DateTime?
  revokedAt      DateTime?
  lastSeenAt     DateTime?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  user           User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  agent          Agent?   @relation(fields: [agentId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([agentId])
}

model MagicLinkToken {
  id            String    @id @default(cuid())
  token         String    @unique
  email         String
  phoneSnapshot String?
  nonce         String    @unique
  expiresAt     DateTime
  usedAt        DateTime?
  createdAt     DateTime  @default(now())

  @@index([email, expiresAt])
}

model Agent {
  id              String           @id @default(cuid())
  userId          String?
  name            String
  status          AgentStatus      @default(draft)
  currentPrompt   String           @default("")
  readyToFinalize Boolean          @default(false)
  botEnabled      Boolean          @default(true)
  carcass         String?
  // Роль бота (v2.2): "admin" | "consultant" | "support" | "qualifier" | "salesman".
  // Денормализована с BusinessProfile.data.botModel для быстрого чтения в рантайме.
  botModel        String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  user            User?            @relation(fields: [userId], references: [id], onDelete: SetNull)
  sessions        Session[]
  businessProfile BusinessProfile?
  promptVersions  PromptVersion[]
  builderMessages  BuilderMessage[]
  testMessages     TestMessage[]
  waConnections    WaConnection[]
  conversations    Conversation[]
  preConnectionChats WaPreConnectionChat[]

  @@index([userId])
}

model BusinessProfile {
  id              String   @id @default(cuid())
  agentId         String   @unique
  data            Json
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  agent           Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)
}

model PromptVersion {
  id              String      @id @default(cuid())
  agentId         String
  content         String
  charCount       Int
  source          PromptSource @default(create)
  createdBy       PromptCreator @default(ai)
  correctionType  String?
  sectionEdited   String?
  parentId        String?
  metadata        Json
  createdAt       DateTime    @default(now())
  agent           Agent       @relation(fields: [agentId], references: [id], onDelete: Cascade)
  parent          PromptVersion? @relation("PromptVersionChildren", fields: [parentId], references: [id], onDelete: SetNull)
  children        PromptVersion[] @relation("PromptVersionChildren")

  @@index([agentId, createdAt])
}

model BuilderMessage {
  id              String    @id @default(cuid())
  agentId         String
  role            String
  content         String
  parts           Json
  createdAt       DateTime  @default(now())
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

model TestMessage {
  id              String    @id @default(cuid())
  agentId         String
  role            String
  content         String
  parts           Json
  createdAt       DateTime  @default(now())
  agent           Agent     @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId, createdAt])
}

model WaConnection {
  id                  String        @id @default(cuid())
  agentId             String        @unique
  phone               String?
  status              WaStatus      @default(disconnected)
  authState           Json
  authStateUpdatedAt  DateTime?
  qrText              String?
  qrDataUrl           String?
  workerSessionId     String?
  lastSeenAt          DateTime?
  // Бот отвечает только на сообщения с messageTimestamp >= этой даты И
  // только в Conversation, созданных >= этой даты. Защита от:
  //   - history sync flood при подключении (старые непрочитанные от друзей,
  //     которые WhatsApp догоняет за последний месяц);
  //   - вторжения бота в чаты, которые шли вне его.
  // Выставляется автоматически при каждом успешном connection.open.
  // NULL = «фильтр выключен» (legacy / dev).
  botRespondsSince    DateTime?
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt
  agent               Agent         @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([agentId])
}

/// Реестр «WA-номеров, застолблённых пользователями».
///
/// Один и тот же WhatsApp-номер можно привязать только к ОДНОМУ аккаунту
/// Jazu (анти-абуз бесплатного периода). Когда worker подтверждает
/// успешный pairing (connection.update → open), API хэширует реальный
/// номер с HMAC(PHONE_HASH_PEPPER) и атомарно вставляет сюда строку.
/// Если phoneHash уже есть с другим userId — pairing откатывается,
/// сокет рвётся, юзеру показываем ошибку.
///
/// phoneHash — HMAC-SHA256(normalized digits, env.PHONE_HASH_PEPPER) в hex.
/// Pepper никогда не меняется (иначе старые хэши перестанут сходиться).
/// Запись живёт вечно: «отпускает» номер только админ ручным DELETE.
model WaPhoneClaim {
  id            String   @id @default(cuid())
  phoneHash     String   @unique
  // userId nullable И onDelete: SetNull. При удалении аккаунта userId
  // обнуляется, но запись остаётся — иначе сломается анти-абуз (юзер мог
  // бы удалить аккаунт, перерегаться и заново выжечь free trial с того же
  // номера). Хэш без userId — обезличенные данные, не PII.
  userId        String?
  agentId       String?
  firstBoundAt  DateTime @default(now())
  lastBoundAt   DateTime @default(now())
  user          User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Снимок чатов, существовавших в WhatsApp ДО подключения бота.
///
/// Заполняется из history-sync (messaging-history.set) в момент первой
/// привязки. Бот НИКОГДА не отвечает в этих чатах — это старые личные
/// переписки владельца, в которые бот не должен вторгаться. В отличие от
/// фильтра по messageTimestamp/Conversation.createdAt, ловит и те старые
/// чаты, которых ещё нет в нашей БД (клиент написал в них впервые после
/// подключения свежим сообщением).
///
/// Чистится при «Отключить» (Cascade с Agent + явно в DELETE /whatsapp).
model WaPreConnectionChat {
  id        String   @id @default(cuid())
  agentId   String
  waChatId  String
  createdAt DateTime @default(now())
  agent     Agent    @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@unique([agentId, waChatId])
  @@index([agentId])
}

model Conversation {
  id              String       @id @default(cuid())
  agentId         String
  waChatId        String
  customerName    String?
  status          ConversationStatus @default(open)
  // Буфер «потребности клиента» для боевого WhatsApp-диалога (v2.3). Пишется при
  // первом извлечении и при явной смене запроса (needChanged).
  detectedNeed    String?
  lastMessageAt   DateTime?    @default(now())
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  agent           Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)
  messages        WaMessage[]
  leads           Lead[]

  @@unique([agentId, waChatId])
  @@index([agentId, lastMessageAt])
}

model WaMessage {
  id              String    @id @default(cuid())
  conversationId  String
  direction       MessageDirection
  body            String
  waMsgId         String?
  parts           Json
  createdAt       DateTime  @default(now())
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@unique([conversationId, waMsgId])
  @@index([conversationId, createdAt])
}

model Lead {
  id              String    @id @default(cuid())
  conversationId  String
  summary         String
  niche           String?
  fields          Json
  status          LeadStatus @default(new)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  conversation    Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId, createdAt])
}

enum AgentStatus {
  draft
  active
  archived
}

enum PromptSource {
  create
  edit
  correction
}

enum PromptCreator {
  ai
  user
}

enum WaStatus {
  disconnected
  qr
  pairing
  connected
  error
}

enum ConversationStatus {
  open
  closed
  archived
}

enum MessageDirection {
  in
  out
}

enum LeadStatus {
  new
  seen
  done
}

// Аудит-лог чувствительных действий: логин, выдача/использование magic-link,
// привязка/отвязка WhatsApp, покупка пакета. Используется для:
//   - compliance / разбор инцидентов («когда юзер вошёл с другого IP?»);
//   - алертов по подозрительным паттернам (10 неудачных логинов за минуту);
//   - доказательной базы для биллинговых споров.
// Хранится бессрочно (retention для AuditLog не настраиваем — он маленький).
model AuditLog {
  id        String   @id @default(cuid())
  userId    String?
  event     String   // "login.success" | "login.failed" | "magic_link.issued" | "wa.paired" | ...
  ip        String?
  userAgent String?
  requestId String?
  metadata  Json?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
  @@index([event, createdAt])
  @@index([createdAt])
}
