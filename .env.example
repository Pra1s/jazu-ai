# ============================================================================
# Jazu env example. Скопируйте в .env: `cp .env.example .env`
#
# Все ключи помеченные [PROD MUST] обязательны в production и не должны
# совпадать с dev-дефолтами — иначе API упадёт при старте (см. apps/api/src/env.ts).
# ============================================================================

# === Database ===
DATABASE_URL=postgresql://jazu:jazu@localhost:5432/jazu

# === App origins ===
WEB_ORIGIN=http://localhost:3000
API_ORIGIN=http://localhost:3001
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001/api

# === Internal security ===
# Сгенерировать: openssl rand -hex 32
# [PROD MUST OVERRIDE] оба обязательны.
API_INTERNAL_TOKEN=change-me-in-production-min-16-chars
MAGIC_LINK_SECRET=change-me-in-production-min-16-chars

# Dual-key для бесшовной ротации (zero-downtime). Алгоритм:
#   1. На API выставляете _NEW в основной CURRENT, старый — в _OLD.
#   2. Передеплоиваете API.
#   3. Передеплоиваете wa-worker / jobs с CURRENT=_NEW.
#   4. Чистите _OLD из env API (через 30 минут для MAGIC_LINK — TTL ссылки).
# Пока не ротируете — оставляйте пустыми.
API_INTERNAL_TOKEN_OLD=
MAGIC_LINK_SECRET_OLD=

# === WhatsApp worker ===
# [PROD MUST] URL до wa-worker. Локально: http://localhost:4001.
WA_WORKER_URL=http://localhost:4001
# Если запускаете wa-worker в docker через `docker compose --profile full up`,
# а API на хосте — оставьте дефолт; см. docker-compose.yml.
WA_WORKER_API_ORIGIN=http://host.docker.internal:3001

# === OpenAI ===
# [PROD MUST] боевой ключ. В .env НИКОГДА не коммитить.
# Голосовые ответы (Whisper) всегда ходят на OpenAI — ключ нужен независимо от LLM_*.
OPENAI_API_KEY=sk-...
# Опционально: переопределение модели. Дефолт — gpt-4.1.
OPENAI_MODEL=gpt-4.1

# === LLM-провайдер текстовых ответов (опционально) ===
# По умолчанию (если LLM_* пусты) текст идёт на OpenAI выше.
# Чтобы перевести текст на Gemini через OpenAI-совместимый эндпоинт — раскомментировать:
#   LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
#   LLM_MODEL=gemini-3.1-flash-lite
#   GEMINI_API_KEY=<один платный ключ Gemini>   # или LLM_API_KEY=<ключ>
# Пул ключей (round-robin) — LLM_API_KEYS=key1,key2,...; для одного ключа НЕ задавать.
# Откат на OpenAI: убрать LLM_* переменные (передеплой кода не нужен).
LLM_BASE_URL=
LLM_MODEL=
LLM_API_KEY=
GEMINI_API_KEY=

# === Email (Resend) ===
# [PROD MUST] без этих ключей magic link не доедет до пользователя.
# В dev (NODE_ENV=development) ссылка дополнительно выводится в ответе /auth/magic-link.
RESEND_API_KEY=
FROM_EMAIL=noreply@yourdomain.com

# === Google OAuth (опционально) ===
# Если заданы все три — на /auth появляется кнопка «Войти через Google».
# Если хотя бы одна пустая — фронт скрывает кнопку, бэк отвечает 503.
# В Google Cloud Console → APIs & Services → Credentials → OAuth 2.0 Client ID:
#   Application type:        Web application
#   Authorized redirect URI: ${GOOGLE_REDIRECT_URI}
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# === Telegram hot-lead notifications — опционально ===
TELEGRAM_BOT_TOKEN=

# === Redis / BullMQ ===
# [PROD MUST] обязателен для очередей wa:inbound / wa:outbound.
# Без REDIS_URL wa-worker откатывается на медленный синхронный HTTP-путь
# (вызов /api/whatsapp/inbound прямо из Baileys event loop) — не для прода.
REDIS_URL=redis://localhost:6379

# === Jobs worker ===
# Параллельность обработки wa:inbound в одном контейнере.
# Один LLM-турн ~3-5с, поэтому 10 даёт ~2-3 RPS на контейнер.
# Для большей нагрузки скейлим несколько контейнеров (deploy.replicas).
JOBS_CONCURRENCY=10
# Лок-таймаут одной задачи; должен быть больше самого медленного LLM-вызова.
JOBS_INBOUND_TIMEOUT_MS=60000

# === WhatsApp outbound throttling ===
# Concurrency consumer'а wa:outbound в wa-worker (на разные чаты параллельно).
WA_OUTBOUND_CONCURRENCY=8
# Минимальный интервал между сообщениями ОДНОМУ chatId (мс).
# WhatsApp банит за бурсты, держим консервативно.
WA_PER_CHAT_MIN_INTERVAL_MS=1200

# === Observability ===
# Sentry: оставьте пустым в dev — capture работает в no-op режиме (stderr).
# В проде получите DSN из sentry.io или self-hosted GlitchTip.
SENTRY_DSN=
# Версия релиза для группировки в Sentry. В CI обычно git sha или тег.
RELEASE_VERSION=
# PostHog аналитика. Пусто в dev — capture работает в no-op (фронт и бэк).
# Один токен на фронт и бэк; phc_... публичный.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://analytics.jazu.chat
# Retention в днях: WaMessage / LlmCallLog старше этого порога удаляются
# nightly cron'ом в jobs worker (03:00 UTC). 0 = выключено.
RETENTION_DAYS=90
# Порт встроенного health-сервера в jobs worker.
JOBS_HEALTH_PORT=4002
