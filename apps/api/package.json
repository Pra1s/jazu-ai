{
  "name": "@jazu/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./*": "./src/*.ts"
  },
  "scripts": {
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "build": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "db:migrate-carcass": "tsx --env-file=../../.env scripts/migrate-carcass-layer-b.ts",
    "reset-agent": "tsx --env-file=../../.env scripts/reset-agent.ts",
    "analyze-style": "tsx --env-file=../../.env scripts/analyze-style.ts",
    "start": "node --env-file=../../.env --import tsx/esm src/index.ts"
  },
  "dependencies": {
    "@fastify/cookie": "11.0.2",
    "@fastify/cors": "11.2.0",
    "@fastify/formbody": "8.0.2",
    "@fastify/helmet": "13.0.2",
    "@fastify/rate-limit": "10.3.0",
    "@fastify/sensible": "6.0.4",
    "@jazu/ai": "workspace:*",
    "@jazu/db": "workspace:*",
    "@jazu/observability": "workspace:*",
    "@jazu/queue": "workspace:*",
    "@jazu/shared": "workspace:*",
    "@jazu/wa-pipeline": "workspace:*",
    "dotenv": "^17.4.2",
    "fastify": "5.8.5",
    "ioredis": "5.10.1",
    "pino": "10.3.1",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "tsx": "4.22.3",
    "typescript": "6.0.3"
  }
}
